# Paths are resolved relative to dma/ when not absolute.
DMA_DATABASE_PATH=backend/data/database/airport_ops.db
DMA_CHAT_DATABASE_PATH=backend/data/chat/history.db
DMA_DOCUMENTS_PATH=backend/data/documents
DMA_POLICY_INDEX_PATH=backend/data/policy_index
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Policy text token limits (chunks stay within numbered sections).
DMA_CHUNK_SIZE=512
DMA_CHUNK_OVERLAP=64
DMA_SIMILARITY_TOP_K=14
DMA_EMBED_BATCH_SIZE=16
GEMINI_API_KEY=
# Set a model ID available in your Gemini account.
GEMINI_MODEL=
DMA_ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
